{
  "name": "playset",
  "version": "0.1.0",
  "description": "Turn a setlist.fm setlist into a Spotify playlist",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "playset": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "vite build && vite build --config vite.client.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "web": "vite build --config vite.client.config.ts && tsx src/web/server/main.ts",
    "web:dev": "vite --config vite.client.config.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "1.95.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@inquirer/prompts": "^8.8.1",
    "@tanstack/react-query": "^5.108.4",
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7",
    "zod": "^4.6.7"
  }
}
