{
  "name": "playset",
  "version": "0.1.0",
  "description": "Turn a setlist.fm setlist into a Spotify playlist",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "playset": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "oxlint": "1.95.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.1",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  }
}
